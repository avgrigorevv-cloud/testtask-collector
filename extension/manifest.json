{
  "manifest_version": 3,
  "name": "Скриншоты с метками",
  "short_name": "Метки",
  "version": "1.0.0",
  "description": "Скриншот страницы с метками, областями и замером отступов. Копируется в буфер обмена одной кнопкой. Работает локально в браузере.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Скриншот с метками",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Сделать скриншот с метками"
    }
  }
}
